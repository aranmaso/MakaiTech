    <ThingDef ParentName="BaseBullet">
		<defName>Makai_GreenLaserChained</defName>
		<label>chain beam</label>
		<thingClass>VEF.Weapons.TeslaProjectile</thingClass>
		<drawOffscreen>true</drawOffscreen>
		<graphicData>
			<texPath>Things/Projectile/LightningChain</texPath>
			<graphicClass>Graphic_Flicker</graphicClass>
			<shaderType>MoteGlow</shaderType>
		</graphicData>
		<projectile>
			<damageDef>Existence_Null_Lightning</damageDef>
